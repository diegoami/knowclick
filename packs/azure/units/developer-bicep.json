{
	"id": "developer-bicep",
	"layout": {
		"type": "code",
		"code": [
			"{{gap:input}} location {{gap:inputType}} = {{gap:scope}}().location",
			"{{gap:result}} selectedLocation {{gap:outputType}} = {{gap:value}}"
		]
	},
	"cells": [
		{
			"id": "input",
			"item": "azure:developer-bicep:input",
			"text": "param"
		},
		{
			"id": "value",
			"item": "azure:developer-bicep:value",
			"text": "location"
		},
		{
			"id": "result",
			"item": "azure:developer-bicep:result",
			"text": "output"
		},
		{
			"id": "inputType",
			"item": "azure:developer-bicep:inputType",
			"text": "string"
		},
		{
			"id": "scope",
			"item": "azure:developer-bicep:scope",
			"text": "resourceGroup"
		},
		{
			"id": "outputType",
			"item": "azure:developer-bicep:outputType",
			"text": "string"
		}
	],
	"sources": [
		{
			"title": "Bicep overview",
			"url": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/bicep/overview"
		},
		{
			"title": "Bicep parameters",
			"url": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/bicep/parameters"
		},
		{
			"title": "Bicep outputs",
			"url": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/bicep/outputs"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs bicep",
		"stdin": "{code}",
		"expect": "^compiled$"
	},
	"dealAll": true,
	"distractors": ["var", "resource", "module", "int", "bool", "subscription", "tenant"]
}
