{
	"id": "loops-values-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let mut total = 0;",
			"    for value in 1..=5 {",
			"        {{gap:skip}}",
			"        total += value;",
			"    }",
			"    assert_eq!(total, 9);",
			"    let mut remaining = 3;",
			"    while remaining > 0 { remaining -= 1; }",
			"    assert_eq!(remaining, 0);",
			"    let mut n = 0;",
			"    let answer = loop {",
			"        n += 1;",
			"        {{gap:exit}}",
			"    };",
			"    assert_eq!(answer, 8);",
			"    assert_eq!(n, 4);",
			"}"
		]
	},
	"cells": [
		{
			"id": "skip",
			"item": "rust:loops-values-recall:skip",
			"text": "if value % 2 == 0 { continue; }"
		},
		{
			"id": "exit",
			"item": "rust:loops-values-recall:exit",
			"text": "if n == 4 { break n * 2; }"
		}
	],
