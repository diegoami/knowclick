{
	"id": "string-operations-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let mut text = String::from(\"é\");",
			"    let suffix = String::from(\"clair\");",
			"    {{gap:append}}",
			"    assert_eq!(suffix, \"clair\");",
			"    assert_eq!(text.len(), 7);",
			"    assert_eq!(text.chars().count(), 6);",
			"    assert_eq!(text.get(0..2), Some(\"é\"));",
			"    assert_eq!(text.get(0..1), None);",
			"    let decorated = {{gap:format}};",
			"    assert_eq!(decorated, \"[éclair]\");",
			"    assert_eq!(text, \"éclair\");",
			"    text.push('!');",
			"    assert_eq!(text, \"éclair!\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "append",
			"item": "rust:string-operations-recall:append",
			"text": "text.push_str(suffix.as_str());"
		},
		{
			"id": "format",
			"item": "rust:string-operations-recall:format",
			"text": "format!(\"[{text}]\")"
		}
	],
	"sources": [
