{
	"id": "hashmap-entry",
	"layout": {
		"type": "code",
		"code": [
			"{{gap:import}} std::collections::{{gap:mapType}};",
			"fn main() {",
			"    let {{gap:binding}} counts: HashMap<&str, u32> = HashMap::new();",
			"    for word in \"red blue red\".{{gap:tokens}}() {",
			"        let count = counts.{{gap:entry}}(word).{{gap:default}}(0);",
			"        {{gap:dereference}}count += 1;",
			"    }",
			"    {{gap:equal}}(counts.{{gap:lookup}}(\"red\"), Some(&2));",
			"    assert_eq!(counts.get(\"blue\"), Some(&1));",
			"    assert_eq!(counts.get(\"green\"), None);",
			"    assert_eq!(counts.len(), 2);",
			"    assert_eq!(counts.remove(\"blue\"), Some(1));",
			"    assert!(!counts.contains_key(\"blue\"));",
			"    assert_eq!(counts.get(\"red\"), Some(&2));",
			"}"
		]
	},
