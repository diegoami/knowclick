		"code": [
			"use std::num::ParseIntError;",
			"fn optional(text: Option<&str>) -> Result<Option<u32>, ParseIntError> {",
			"    {{gap:transpose}}",
			"}",
			"fn main() {",
			"    assert_eq!(optional(None).unwrap(), None);",
			"    assert_eq!(optional(Some(\"0\")).unwrap(), Some(0));",
			"    assert_eq!(optional(Some(\"8\")).unwrap(), Some(8));",
			"    assert!(optional(Some(\"bad\")).is_err());",
			"    assert!(optional(Some(\"-1\")).is_err());",
			"    let nested = Some(Some(3));",
			"    assert_eq!({{gap:flatten}}, Some(3));",
			"    let empty: Option<Option<u32>> = Some(None);",
			"    assert_eq!(empty.flatten(), None);",
			"}"
		]
	},
	"cells": [
		{
			"id": "transpose",
			"item": "rust:option-transpose-recall:transpose",
