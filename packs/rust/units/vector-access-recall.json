{
	"id": "vector-access-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let mut values: Vec<u32> = vec![10, 20];",
			"    assert_eq!(values.get(1), Some(&20));",
			"    assert!(values.get(9).is_none());",
			"    let first = {{gap:access}};",
			"    {{gap:append}}",
			"    assert_eq!(first, 10);",
			"    assert_eq!(values.len(), 3);",
			"    assert_eq!(values.pop(), Some(30));",
			"    assert_eq!(values.pop(), Some(20));",
			"    assert_eq!(values.pop(), Some(10));",
			"    assert_eq!(values.pop(), None);",
			"    let empty: Vec<u32> = Vec::new();",
			"    assert_eq!(empty.get(0).copied().unwrap_or(0), 0);",
			"}"
		]
	},
	"cells": [
		{
			"id": "access",
			"item": "rust:vector-access-recall:access",
			"text": "values.get(0).copied().unwrap_or(0)"
		},
		{
			"id": "append",
			"item": "rust:vector-access-recall:append",
			"text": "values.push(30);"
		}
	],
