{
	"id": "loops-values",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let {{gap:binding}} total = 0;",
			"    {{gap:iterate}} value {{gap:membership}} 1{{gap:inclusive}}5 {",
			"        if value % 2 == 0 { {{gap:skip}}; }",
			"        total += value;",
			"    }",
			"    assert_eq!(total, 9);",
			"    let mut remaining = 3;",
			"    {{gap:conditional}} remaining > 0 { remaining -= 1; }",
			"    assert_eq!(remaining, 0);",
			"    let mut n = 0;",
			"    let answer = {{gap:repeat}} {",
			"        n += 1;",
			"        if n == 4 { {{gap:exit}} n * 2; }",
			"    };",
			"    {{gap:equal}}(answer, 8);",
			"    assert_eq!(n, 4);",
			"}"
		]
	},
	"cells": [
		{
			"id": "binding",
			"item": "rust:ownership:mutable",
			"text": "mut"
		},
		{
			"id": "iterate",
			"item": "rust:loops-values:iterate",
			"text": "for"
		},
		{
			"id": "membership",
			"item": "rust:loops-values:membership",
			"text": "in"
		},
		{
			"id": "inclusive",
			"item": "rust:loops-values:inclusive",
			"text": "..="
		},
		{
			"id": "skip",
			"item": "rust:loops-values:skip",
			"text": "continue"
		},
		{
			"id": "conditional",
			"item": "rust:loops-values:conditional",
			"text": "while"
		},
		{
			"id": "repeat",
			"item": "rust:loops-values:repeat",
			"text": "loop"
		},
		{
			"id": "exit",
			"item": "rust:loops-values:exit",
			"text": "break"
		},
		{
			"id": "equal",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Hello, Cargo!",
			"url": "https://doc.rust-lang.org/book/ch01-03-hello-cargo.html"
		},
		{
			"title": "Variables and mutability",
			"url": "https://doc.rust-lang.org/book/ch03-01-variables-and-mutability.html"
		},
		{
			"title": "Data types",
			"url": "https://doc.rust-lang.org/book/ch03-02-data-types.html"
		},
		{
			"title": "Functions",
			"url": "https://doc.rust-lang.org/book/ch03-03-how-functions-work.html"
		},
		{
			"title": "Control flow",
			"url": "https://doc.rust-lang.org/book/ch03-05-control-flow.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": ["let", "if", "match", "return", "..", "iter", "into", "yield"],
	"recallUnit": "loops-values-recall"
}
