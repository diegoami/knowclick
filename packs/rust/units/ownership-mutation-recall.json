{
	"id": "ownership-mutation-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn add_tag(text: &mut String, tag: &str) {",
			"    text.push(':');",
			"    text.push_str(tag);",
			"}",
			"fn byte_count(text: &str) -> usize { text.len() }",
			"fn main() {",
			"    let mut name = String::from(\"log\");",
			"    {{gap:mutate}};",
			"    assert_eq!(name, \"log:ok\");",
			"    assert_eq!({{gap:inspect}}, 6);",
			"    name.clear();",
			"    assert!(name.is_empty());",
			"    add_tag(&mut name, \"\");",
			"    assert_eq!(name, \":\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "mutate",
			"item": "rust:ownership-mutation-recall:mutate",
			"text": "add_tag(&mut name, \"ok\")"
		},
		{
			"id": "inspect",
			"item": "rust:ownership-mutation-recall:inspect",
			"text": "byte_count(&name)"
		}
	],
