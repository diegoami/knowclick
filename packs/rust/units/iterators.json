{
	"id": "iterators",
	"layout": {
		"type": "code",
		"code": [
			"{{gap:function}} main() {",
			"    let values = {{gap:vector}}[1_{{gap:number}}, 2, 3, 4];",
			"    let doubled: {{gap:collection}}<i32> = values.{{gap:borrow}}()",
			"        .{{gap:retain}}(|value| **value % 2 == 0)",
			"        .{{gap:convert}}(|value| *value * 2)",
			"        .{{gap:finish}}();",
			"    {{gap:assertion}}(doubled, vec![4, 8]);",
			"    assert_eq!(values.{{gap:length}}(), 4);",
			"}"
		]
	},
	"cells": [
		{
			"id": "borrow",
			"item": "rust:iterators:borrow",
			"text": "iter"
		},
		{
			"id": "retain",
			"item": "rust:iterators:retain",
			"text": "filter"
		},
		{
			"id": "convert",
			"item": "rust:iterators:convert",
			"text": "map"
		},
		{
			"id": "finish",
			"item": "rust:iterators:finish",
			"text": "collect"
		},
		{
			"id": "vector",
			"item": "rust:iterators:vector",
			"text": "vec!"
		},
		{
			"id": "number",
			"item": "rust:iterators:number",
			"text": "i32"
		},
		{
			"id": "collection",
			"item": "rust:iterators:collection",
			"text": "Vec"
		},
		{
			"id": "assertion",
			"item": "rust:iterators:assertion",
			"text": "assert_eq!"
		},
		{
			"id": "function",
			"item": "rust:iterators:function",
			"text": "fn"
		},
		{
			"id": "length",
			"item": "rust:iterators:length",
			"text": "len"
		}
	],
	"sources": [
		{
			"title": "Iterators",
			"url": "https://doc.rust-lang.org/book/ch13-02-iterators.html"
		},
		{
			"title": "Command line project",
			"url": "https://doc.rust-lang.org/book/ch12-00-an-io-project.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": [
		"into_iter",
		"iter_mut",
		"for_each",
		"find",
		"fold",
		"String",
		"HashMap",
		"assert!"
	],
	"recallUnit": "iterators-recall"
}
