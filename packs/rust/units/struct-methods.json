{
	"id": "struct-methods",
	"layout": {
		"type": "code",
		"code": [
			"{{gap:record}} Label { text: String }",
			"{{gap:implementation}} Label {",
			"    fn new(text: String) -> {{gap:selfType}} { Self { text } }",
			"    fn text({{gap:shared}}) -> {{gap:view}} { &self.text }",
			"    fn append({{gap:exclusive}}, suffix: &str) { self.text.{{gap:append}}(suffix); }",
			"    fn into_text({{gap:consume}}) -> String { self.text }",
			"}",
			"fn main() {",
			"    let {{gap:binding}} label = Label::new(String::from(\"note\"));",
			"    assert_eq!(label.text(), \"note\");",
			"    label.append(\"!\");",
			"    let owned = label.into_text();",
			"    {{gap:equal}}(owned, \"note!\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "record",
			"item": "rust:struct-methods:record",
			"text": "struct"
		},
		{
			"id": "implementation",
			"item": "rust:struct-methods:implementation",
			"text": "impl"
		},
		{
			"id": "selfType",
			"item": "rust:struct-methods:selfType",
			"text": "Self"
		},
		{
			"id": "shared",
			"item": "rust:struct-methods:shared",
			"text": "&self"
		},
		{
			"id": "view",
			"item": "rust:ownership:sharedType",
			"text": "&str"
		},
		{
			"id": "exclusive",
			"item": "rust:struct-methods:exclusive",
			"text": "&mut self"
		},
		{
			"id": "append",
			"item": "rust:struct-methods:append",
			"text": "push_str"
		},
		{
			"id": "consume",
			"item": "rust:struct-methods:consume",
			"text": "self"
		},
		{
			"id": "binding",
			"item": "rust:ownership:mutable",
			"text": "mut"
		},
		{
			"id": "equal",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Structs",
			"url": "https://doc.rust-lang.org/book/ch05-01-defining-structs.html"
		},
		{
			"title": "Methods",
			"url": "https://doc.rust-lang.org/book/ch05-03-method-syntax.html"
		},
		{
			"title": "Matching",
			"url": "https://doc.rust-lang.org/book/ch06-02-match.html"
		},
		{
			"title": "Concise conditional matching",
			"url": "https://doc.rust-lang.org/book/ch06-03-if-let.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": ["enum", "trait", "&Self", "&mut String", "String", "&String", "push", "pub"],
	"recallUnit": "struct-methods-recall"
}
