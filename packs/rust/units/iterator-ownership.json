{
	"id": "iterator-ownership",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let {{gap:binding}} names = vec![String::from(\"a\"), String::from(\"bb\")];",
			"    let sizes: {{gap:sizesType}} = names.{{gap:borrowed}}().{{gap:transform}}(|name| name.len()).{{gap:gather}}();",
			"    assert_eq!(sizes, vec![1, 2]);",
			"    assert_eq!(names.len(), 2);",
			"    for name in names.{{gap:mutable}}() { name.{{gap:append}}('!'); }",
			"    assert_eq!(names[0], \"a!\");",
			"    let owned: {{gap:ownedType}} = names.{{gap:consuming}}().collect();",
			"    {{gap:equal}}(owned, vec![String::from(\"a!\"), String::from(\"bb!\")]);",
			"    assert_eq!(Vec::<String>::new().into_iter().count(), 0);",
			"}"
		]
	},
	"cells": [
		{
			"id": "binding",
			"item": "rust:ownership:mutable",
			"text": "mut"
		},
		{
			"id": "sizesType",
			"item": "rust:iterator-ownership:sizesType",
			"text": "Vec<usize>"
		},
		{
			"id": "borrowed",
			"item": "rust:iterators:borrow",
			"text": "iter"
		},
		{
			"id": "transform",
			"item": "rust:iterators:convert",
			"text": "map"
		},
		{
			"id": "gather",
			"item": "rust:iterators:finish",
			"text": "collect"
		},
		{
			"id": "mutable",
			"item": "rust:iterator-ownership:mutable",
			"text": "iter_mut"
		},
		{
			"id": "append",
			"item": "rust:ownership:append",
			"text": "push"
		},
		{
			"id": "ownedType",
			"item": "rust:iterator-ownership:ownedType",
			"text": "Vec<String>"
		},
		{
			"id": "consuming",
			"item": "rust:iterator-ownership:consuming",
			"text": "into_iter"
		},
		{
			"id": "equal",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Iterators",
			"url": "https://doc.rust-lang.org/book/ch13-02-iterators.html"
		},
		{
			"title": "Iterator API",
			"url": "https://doc.rust-lang.org/std/iter/trait.Iterator.html"
		},
		{
			"title": "Slice API",
			"url": "https://doc.rust-lang.org/std/primitive.slice.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": [
		"Vec<&str>",
		"Vec<u32>",
		"cloned",
		"copied",
		"filter",
		"fold",
		"push_str",
		"next"
	],
	"recallUnit": "iterator-ownership-recall"
}
