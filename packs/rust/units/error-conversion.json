{
	"id": "error-conversion",
	"layout": {
		"type": "code",
		"code": [
			"use std::num::ParseIntError;",
			"#[derive(Debug, PartialEq)]",
			"{{gap:errorEnum}} ConfigError { Missing, Invalid, Zero }",
			"fn positive(input: Option<&str>) -> {{gap:resultType}} {",
			"    let text = input.{{gap:required}}(ConfigError::Missing){{gap:propagateMissing}};",
			"    let value = text.parse::<u32>().{{gap:convert}}(|_: ParseIntError| ConfigError::Invalid){{gap:propagateInvalid}};",
			"    if value == 0 { return {{gap:failure}}(ConfigError::Zero); }",
			"    {{gap:success}}(value)",
			"}",
			"fn main() {",
			"    assert_eq!(positive(Some(\"7\")), Ok(7));",
			"    assert_eq!(positive(None), Err(ConfigError::Missing));",
			"    assert_eq!(positive(Some(\"bad\")), Err(ConfigError::Invalid));",
			"    assert_eq!(positive(Some(\"-1\")), Err(ConfigError::Invalid));",
			"    {{gap:equal}}(positive(Some(\"0\")), Err(ConfigError::Zero));",
			"}"
		]
	},
	"cells": [
		{
			"id": "errorEnum",
			"item": "rust:error-conversion:errorEnum",
			"text": "enum"
		},
		{
			"id": "resultType",
			"item": "rust:error-conversion:resultType",
			"text": "Result<u32, ConfigError>"
		},
		{
			"id": "required",
			"item": "rust:error-conversion:required",
			"text": "ok_or"
		},
		{
			"id": "propagateMissing",
			"item": "rust:errors:propagate",
			"text": "?"
		},
		{
			"id": "convert",
			"item": "rust:error-conversion:convert",
			"text": "map_err"
		},
		{
			"id": "propagateInvalid",
			"item": "rust:error-conversion:propagateInvalid",
			"text": "?"
		},
		{
			"id": "failure",
			"item": "rust:error-conversion:failure",
			"text": "Err"
		},
		{
			"id": "success",
			"item": "rust:errors:success",
			"text": "Ok"
		},
		{
			"id": "equal",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Recoverable errors",
			"url": "https://doc.rust-lang.org/book/ch09-02-recoverable-errors-with-result.html"
		},
		{
			"title": "Option API",
			"url": "https://doc.rust-lang.org/std/option/enum.Option.html"
		},
		{
			"title": "Result API",
			"url": "https://doc.rust-lang.org/std/result/enum.Result.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": ["Option<u32>", "unwrap", "unwrap_or", "map", "ok", "Some", "None", "expect"],
	"recallUnit": "error-conversion-recall"
}
