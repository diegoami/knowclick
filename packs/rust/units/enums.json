{
	"id": "enums",
	"layout": {
		"type": "code",
		"code": [
			"{{gap:declare}} Job { {{gap:waitingVariant}}, {{gap:readyVariant}} }",
			"{{gap:function}} label(job: {{gap:parameterType}}) -> &'static {{gap:returnType}} {",
			"    {{gap:select}} job {",
			"        Job::{{gap:waitingArm}} => \"waiting\",",
			"        Job::{{gap:finished}} => \"ready\",",
			"    }",
			"}",
			"fn main() {",
			"    {{gap:assertion}}(label(Job::Waiting), \"waiting\");",
			"    assert_eq!(label(Job::Ready), \"ready\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "declare",
			"item": "rust:enums:declare",
			"text": "enum"
		},
		{
			"id": "select",
			"item": "rust:enums:select",
			"text": "match"
		},
		{
			"id": "finished",
			"item": "rust:enums:finished",
			"text": "Ready"
		},
		{
			"id": "waitingVariant",
			"item": "rust:enums:waitingVariant",
			"text": "Waiting"
		},
		{
			"id": "readyVariant",
			"item": "rust:enums:readyVariant",
			"text": "Ready"
		},
		{
			"id": "function",
			"item": "rust:enums:function",
			"text": "fn"
		},
		{
			"id": "parameterType",
			"item": "rust:enums:parameterType",
			"text": "Job"
		},
		{
			"id": "returnType",
			"item": "rust:enums:returnType",
			"text": "str"
		},
		{
			"id": "waitingArm",
			"item": "rust:enums:waitingArm",
			"text": "Waiting"
		},
		{
			"id": "assertion",
			"item": "rust:enums:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Enums and pattern matching",
			"url": "https://doc.rust-lang.org/book/ch06-00-enums.html"
		},
		{
			"title": "Functions",
			"url": "https://doc.rust-lang.org/book/ch03-03-how-functions-work.html"
		},
		{
			"title": "String slices",
			"url": "https://doc.rust-lang.org/book/ch04-03-slices.html"
		},
		{
			"title": "assert_eq! macro",
			"url": "https://doc.rust-lang.org/std/macro.assert_eq.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"recallUnit": "enums-match",
	"dealAll": true,
	"distractors": ["struct", "trait", "impl", "if", "loop", "while", "String", "assert!"]
}
