{
	"id": "trait-bounds-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn larger<T>(left: &T, right: &T) -> T",
			"{{gap:where}}",
			"{",
			"    {{gap:select}}",
			"}",
			"fn duplicate<T: Clone>(value: &T) -> T { value.clone() }",
			"fn main() {",
			"    assert_eq!(larger(&4_i32, &9), 9);",
			"    assert_eq!(larger(&9_i32, &4), 9);",
			"    assert_eq!(larger(&4_i32, &4), 4);",
			"    assert_eq!(larger(&-7_i32, &-2), -2);",
			"    assert_eq!(larger(&'a', &'z'), 'z');",
			"    let original = String::from(\"kept\");",
			"    let mut copied = duplicate(&original);",
			"    copied.push('!');",
			"    assert_eq!(copied, \"kept!\");",
			"    assert_eq!(original, \"kept\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "where",
			"item": "rust:trait-bounds-recall:where",
			"text": "where T: Ord + Copy"
		},
		{
			"id": "select",
			"item": "rust:trait-bounds-recall:select",
			"text": "if left >= right { *left } else { *right }"
		}
	],
