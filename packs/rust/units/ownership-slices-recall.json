			"    let numbers = [10, 20, 30, 40];",
			"    let middle: &[i32] = {{gap:middle}};",
			"    assert_eq!(middle, &[20, 30]);",
			"    assert_eq!(numbers[0], 10);",
			"    assert_eq!(text, \"éclair\");",
			"}"
