{
	"id": "iterator-short-circuit",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let values = [2, 4, 7, 8];",
			"    let total = values.{{gap:borrow}}().{{gap:copy}}().{{gap:reduce}}(0, |acc, value| acc + value);",
			"    assert_eq!(total, 21);",
			"    let mut visited = 0;",
			"    let has_odd = values.iter().{{gap:observe}}(|_| visited += 1).{{gap:exists}}(|value| value % 2 != 0);",
			"    assert!(has_odd);",
			"    assert_eq!(visited, 3);",
			"    assert!(!values.iter().{{gap:every}}(|value| value % 2 == 0));",
			"    assert_eq!(values.iter().copied().{{gap:first}}(|value| *value > 4), Some(7));",
			"    let empty: [i32; 0] = [];",
			"    assert!(empty.iter().all(|value| *value > 0));",
			"    assert!(!empty.iter().any(|value| *value > 0));",
			"    let mut cursor = values.iter();",
			"    assert_eq!(cursor.{{gap:advance}}(), Some({{gap:reference}}2));",
			"    {{gap:equal}}(cursor.count(), 3);",
			"}"
		]
	},
