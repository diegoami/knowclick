{
	"id": "vector-mutation-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let mut values = vec![3_i32, -1, 3, 2, 2];",
			"    values.sort();",
			"    values.dedup();",
			"    {{gap:retain}}",
			"    {{gap:mutate}}",
			"    assert_eq!(values, vec![4, 6]);",
			"    values.truncate(1);",
			"    assert_eq!(values, vec![4]);",
			"    let mut empty: Vec<i32> = Vec::new();",
			"    empty.sort();",
			"    empty.dedup();",
			"    empty.retain(|value| *value > 0);",
			"    assert!(empty.is_empty());",
			"}"
		]
	},
	"cells": [
		{
			"id": "retain",
			"item": "rust:vector-mutation-recall:retain",
			"text": "values.retain(|value| *value > 0);"
		},
		{
			"id": "mutate",
			"item": "rust:vector-mutation-recall:mutate",
			"text": "for value in values.iter_mut() { *value *= 2; }"
		}
	],
