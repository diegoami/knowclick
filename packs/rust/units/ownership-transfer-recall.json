{
	"id": "ownership-transfer-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn decorate(mut text: String) -> String {",
			"    text.push_str(\"!\");",
			"    text",
			"}",
			"fn main() {",
			"    let count: u32 = 4;",
			"    let copied = count;",
			"    assert_eq!(count + copied, 8);",
			"    let original = String::from(\"red\");",
			"    let mut independent = {{gap:copy}};",
			"    independent.push('?');",
			"    let moved = {{gap:move}};",
			"    assert_eq!(moved, \"red!\");",
			"    assert_eq!(independent, \"red?\");",
			"    assert_eq!(moved.len(), 4);",
			"}"
		]
	},
	"cells": [
		{
			"id": "copy",
			"item": "rust:ownership-transfer-recall:copy",
			"text": "original.clone()"
		},
		{
			"id": "move",
			"item": "rust:ownership-transfer-recall:move",
			"text": "decorate(original)"
		}
	],
	"sources": [
