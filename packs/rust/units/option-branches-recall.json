{
	"id": "option-branches-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn doubled(input: Option<u32>) -> u32 {",
			"    {{gap:double}}",
			"}",
			"fn width(input: Option<&str>) -> usize {",
			"    {{gap:early}}",
			"    text.len()",
			"}",
			"fn main() {",
			"    assert_eq!(doubled(Some(5)), 10);",
			"    assert_eq!(doubled(None), 0);",
			"    assert_eq!(width(Some(\"abc\")), 3);",
			"    assert_eq!(width(Some(\"\")), 0);",
			"    assert_eq!(width(None), 0);",
			"}"
		]
	},
	"cells": [
		{
			"id": "double",
			"item": "rust:option-branches-recall:double",
			"text": "if let Some(value) = input { value * 2 } else { 0 }"
		},
		{
			"id": "early",
			"item": "rust:option-branches-recall:early",
			"text": "let Some(text) = input else { return 0; };"
		}
	],
	"sources": [
