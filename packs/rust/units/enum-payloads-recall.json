		"code": [
			"enum Reading { Idle, Count(u32), Named { name: String, value: u32 } }",
			"fn amount(reading: &Reading) -> u32 {",
			"    match reading {",
			"        Reading::Idle => 0,",
			"        {{gap:countArm}},",
			"        {{gap:namedArm}},",
			"    }",
			"}",
			"fn main() {",
			"    let reading = Reading::Named { name: String::from(\"hits\"), value: 7 };",
			"    assert_eq!(amount(&reading), 7);",
			"    if let Reading::Named { name, .. } = &reading {",
			"        assert_eq!(name, \"hits\");",
			"    }",
			"    assert_eq!(amount(&Reading::Count(3)), 3);",
			"    assert_eq!(amount(&Reading::Idle), 0);",
			"}"
		]
	},
