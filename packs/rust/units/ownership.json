{
	"id": "ownership",
	"layout": {
		"type": "code",
		"code": [
			"fn byte_count(value: &{{gap:slice}}) -> {{gap:lengthType}} {",
			"    value.{{gap:length}}()",
			"}",
			"fn main() {",
			"    let {{gap:mutable}} label = {{gap:owned}}::from(\"cloud\");",
			"    {{gap:assertion}}(byte_count({{gap:borrow}}label), 5);",
			"    let view: {{gap:sharedType}} = &label;",
			"    assert_eq!(view, \"cloud\");",
			"    {",
			"        let editable: {{gap:mutableType}} = &mut label;",
			"        editable.{{gap:append}}('!');",
			"    }",
			"    assert_eq!(label, \"cloud!\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "owned",
			"item": "rust:ownership:owned",
			"text": "String"
		},
		{
			"id": "borrow",
			"item": "rust:ownership:borrow",
			"text": "&"
		},
		{
			"id": "slice",
			"item": "rust:ownership:slice",
			"text": "str"
		},
		{
			"id": "lengthType",
			"item": "rust:ownership:lengthType",
			"text": "usize"
		},
		{
			"id": "length",
			"item": "rust:ownership:length",
			"text": "len"
		},
		{
			"id": "mutable",
			"item": "rust:ownership:mutable",
			"text": "mut"
		},
		{
			"id": "assertion",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		},
		{
			"id": "sharedType",
			"item": "rust:ownership:sharedType",
			"text": "&str"
		},
		{
			"id": "mutableType",
			"item": "rust:ownership:mutableType",
			"text": "&mut String"
