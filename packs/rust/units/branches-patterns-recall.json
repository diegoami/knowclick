{
	"id": "branches-patterns-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn band(value: i32) -> &'static str {",
			"    if value < 0 { \"negative\" }",
			"    else if value == 0 { \"zero\" }",
			"    else { \"positive\" }",
			"}",
			"fn category(code: u32) -> &'static str {",
			"    match code {",
			"        {{gap:either}},",
			"        {{gap:range}},",
			"        _ => \"other\",",
			"    }",
			"}",
			"fn main() {",
			"    assert_eq!(band(-1), \"negative\");",
			"    assert_eq!(band(0), \"zero\");",
			"    assert_eq!(band(1), \"positive\");",
			"    assert_eq!(category(1), \"small\");",
			"    assert_eq!(category(2), \"small\");",
			"    assert_eq!(category(3), \"middle\");",
			"    assert_eq!(category(5), \"middle\");",
			"    assert_eq!(category(0), \"other\");",
			"    assert_eq!(category(6), \"other\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "range",
			"item": "rust:branches-patterns-recall:range",
			"text": "3..=5 => \"middle\""
		},
		{
			"id": "either",
			"item": "rust:branches-patterns-recall:either",
			"text": "1 | 2 => \"small\""
		}
	],
