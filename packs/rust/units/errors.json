{
	"id": "errors",
	"layout": {
		"type": "code",
		"code": [
			"fn count(text: &str) -> {{gap:return}}<u32, std::num::ParseIntError> {",
			"    let value = text.parse::<u32>(){{gap:propagate}};",
			"    {{gap:success}}(value)",
			"}",
			"fn main() {",
			"    assert_eq!(count(\"27\").unwrap(), 27);",
			"    assert!(count(\"many\").is_err());",
			"}"
		]
	},
	"cells": [
		{
			"id": "return",
			"item": "rust:errors:return",
			"text": "Result"
		},
		{
			"id": "propagate",
			"item": "rust:errors:propagate",
			"text": "?"
		},
		{
			"id": "success",
			"item": "rust:errors:success",
			"text": "Ok"
		}
	],
	"sources": [
		{
			"title": "Recoverable errors with Result",
			"url": "https://doc.rust-lang.org/book/ch09-02-recoverable-errors-with-result.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	}
}
