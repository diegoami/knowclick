{
	"id": "errors",
	"layout": {
		"type": "code",
		"code": [
			"fn count(text: &str) -> {{gap:return}}<{{gap:number}}, std::num::{{gap:error}}> {",
			"    let value = text.{{gap:parse}}::<u32>(){{gap:propagate}};",
			"    {{gap:success}}(value)",
			"}",
			"fn main() {",
			"    assert_eq!(count(\"27\").unwrap(), 27);",
			"    assert!(count(\"many\").{{gap:failed}}());",
			"}"
		]
	},
	"cells": [
		{
			"id": "return",
			"item": "rust:errors:return",
			"text": "Result"
		},
		{
			"id": "propagate",
			"item": "rust:errors:propagate",
			"text": "?"
		},
		{
			"id": "success",
			"item": "rust:errors:success",
			"text": "Ok"
		},
		{
			"id": "number",
			"item": "rust:errors:number",
			"text": "u32"
		},
		{
			"id": "error",
			"item": "rust:errors:error",
			"text": "ParseIntError"
		},
		{
			"id": "parse",
			"item": "rust:errors:parse",
			"text": "parse"
		},
		{
			"id": "failed",
			"item": "rust:errors:failed",
			"text": "is_err"
		}
	],
	"sources": [
		{
			"title": "Recoverable errors with Result",
			"url": "https://doc.rust-lang.org/book/ch09-02-recoverable-errors-with-result.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": ["Option", "Err", "Some", "None", "unwrap", "expect", "i32", "is_ok"]
}
