{
	"id": "string-operations",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let {{gap:binding}} text = {{gap:owned}}::from(\"é\");",
			"    let suffix = String::from(\"clair\");",
			"    text.{{gap:append}}(suffix.{{gap:borrowed}}());",
			"    assert_eq!(suffix, \"clair\");",
			"    assert_eq!(text.{{gap:bytes}}(), 7);",
			"    assert_eq!(text.{{gap:characters}}().count(), 6);",
			"    assert_eq!(text.{{gap:checked}}(0..2), Some(\"é\"));",
			"    assert_eq!(text.get(0..1), None);",
			"    let decorated = {{gap:formatting}}(\"[{text}]\");",
			"    {{gap:equal}}(decorated, \"[éclair]\");",
			"    assert_eq!(text, \"éclair\");",
			"    text.push('!');",
			"    assert_eq!(text, \"éclair!\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "binding",
			"item": "rust:ownership:mutable",
			"text": "mut"
		},
		{
			"id": "owned",
			"item": "rust:ownership:owned",
			"text": "String"
		},
		{
			"id": "append",
			"item": "rust:string-operations:append",
			"text": "push_str"
		},
		{
			"id": "borrowed",
			"item": "rust:string-operations:borrowed",
			"text": "as_str"
		},
		{
			"id": "bytes",
			"item": "rust:ownership:length",
			"text": "len"
		},
		{
			"id": "characters",
			"item": "rust:string-operations:characters",
			"text": "chars"
		},
		{
			"id": "checked",
			"item": "rust:string-operations:checked",
			"text": "get"
		},
		{
			"id": "formatting",
			"item": "rust:string-operations:formatting",
			"text": "format!"
		},
		{
			"id": "equal",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Vectors",
			"url": "https://doc.rust-lang.org/book/ch08-01-vectors.html"
		},
		{
			"title": "Strings",
			"url": "https://doc.rust-lang.org/book/ch08-02-strings.html"
		},
		{
			"title": "Hash maps",
			"url": "https://doc.rust-lang.org/book/ch08-03-hash-maps.html"
		},
		{
			"title": "String API",
			"url": "https://doc.rust-lang.org/std/string/struct.String.html"
		},
		{
			"title": "str API",
			"url": "https://doc.rust-lang.org/std/primitive.str.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": ["str", "&str", "push", "bytes", "capacity", "into_bytes", "concat!", "println!"],
	"recallUnit": "string-operations-recall"
}
