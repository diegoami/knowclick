{
	"id": "enums-match",
	"layout": {
		"type": "code",
		"code": [
			"enum Job { Waiting, Running, Ready, Failed }",
			"fn label(job: Job) -> &'static str {",
			"    match job {",
			"        {{gap:waiting}},",
			"        {{gap:running}},",
			"        {{gap:ready}},",
			"        {{gap:failed}},",
			"    }",
			"}",
			"fn main() {",
			"    assert_eq!(label(Job::Waiting), \"waiting\");",
			"    assert_eq!(label(Job::Running), \"running\");",
			"    assert_eq!(label(Job::Ready), \"ready\");",
			"    assert_eq!(label(Job::Failed), \"failed\");",
			"}"
		]
	},
	"cells": [
		{
			"id": "waiting",
			"item": "rust:enums-match:waiting",
			"text": "Job::Waiting => \"waiting\""
		},
