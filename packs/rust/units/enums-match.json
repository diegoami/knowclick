			"id": "ready",
			"item": "rust:enums-match:ready",
			"text": "Job::Ready => \"ready\""
		},
		{
			"id": "running",
			"item": "rust:enums-match:running",
			"text": "Job::Running => \"running\""
		},
		{
			"id": "failed",
