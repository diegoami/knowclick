{
	"id": "module-privacy",
	"layout": {
		"type": "code",
		"code": [
			"mod store {",
			"    {{gap:visible}} {{gap:record}} Counter { value: u32 }",
			"    {{gap:implementation}} Counter {",
			"        pub fn new() -> {{gap:selfType}} { Self { value: 0 } }",
			"        pub fn value({{gap:shared}}) -> u32 { self.value }",
			"        pub fn increment({{gap:exclusive}}) { self.value += 1; }",
			"    }",
			"}",
			"fn main() {",
			"    let {{gap:binding}} counter = store::Counter::new();",
			"    assert_eq!(counter.value(), 0);",
			"    counter.increment();",
			"    counter.increment();",
			"    {{gap:equal}}(counter.value(), 2);",
			"}"
		]
	},
	"cells": [
		{
			"id": "visible",
			"item": "rust:module-privacy:visible",
			"text": "pub"
		},
		{
			"id": "record",
			"item": "rust:module-privacy:record",
			"text": "struct"
		},
		{
			"id": "implementation",
			"item": "rust:module-privacy:implementation",
			"text": "impl"
		},
		{
			"id": "selfType",
			"item": "rust:module-privacy:selfType",
			"text": "Self"
		},
		{
			"id": "shared",
			"item": "rust:module-privacy:shared",
			"text": "&self"
		},
		{
			"id": "exclusive",
			"item": "rust:module-privacy:exclusive",
			"text": "&mut self"
		},
		{
			"id": "binding",
			"item": "rust:ownership:mutable",
			"text": "mut"
		},
		{
			"id": "equal",
			"item": "rust:ownership:assertion",
			"text": "assert_eq!"
		}
	],
	"sources": [
		{
			"title": "Modules and privacy",
			"url": "https://doc.rust-lang.org/book/ch07-02-defining-modules-to-control-scope-and-privacy.html"
		},
		{
			"title": "Paths",
			"url": "https://doc.rust-lang.org/book/ch07-03-paths-for-referring-to-an-item-in-the-module-tree.html"
		},
		{
			"title": "Imports and re-exports",
			"url": "https://doc.rust-lang.org/book/ch07-04-bringing-paths-into-scope-with-the-use-keyword.html"
		},
		{
			"title": "Method receivers",
			"url": "https://doc.rust-lang.org/book/ch05-03-method-syntax.html"
		}
	],
	"verify": {
		"run": "node scripts/verify-local-code.mjs rust",
		"stdin": "{code}",
		"expect": "^verified$"
	},
	"dealAll": true,
	"distractors": [
		"enum",
		"trait",
		"Self::value",
		"self",
		"&Self",
		"&mut Counter",
		"pub(crate)",
		"pub(super)"
	],
	"recallUnit": "module-privacy-recall"
}
