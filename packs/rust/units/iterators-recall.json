{
	"id": "iterators-recall",
	"layout": {
		"type": "code",
		"code": [
			"fn main() {",
			"    let values = vec![1_i32, 2, 3, 4];",
			"    let doubled: Vec<i32> = values.iter()",
			"        {{gap:filter}}",
			"        {{gap:double}}",
			"        .collect();",
			"    assert_eq!(doubled, vec![4, 8]);",
			"    assert_eq!(values.len(), 4);",
			"}"
		]
	},
