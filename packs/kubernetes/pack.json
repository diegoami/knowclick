	],
	"verify": {
		"guard": { "run": "kubectl config current-context", "expect": "^kind-knowclick$" },
		"version": "kubectl version | tr '\\n' ' '",
		"setup": [
			"kubectl delete namespace knowclick-verify --ignore-not-found --wait",
			"kubectl create namespace knowclick-verify",
			"kubectl -n knowclick-verify create deployment web --image=nginx:1.27",
			"kubectl -n knowclick-verify create cronjob pi --image=perl:5.40 --schedule='*/5 * * * *' -- perl -e 'print 1'"
		],
		"teardown": ["kubectl delete namespace knowclick-verify --wait=false"]
	}
}
